{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@entropy-tamer/reynard-i18n": [
        "../packages/core/i18n/src"
      ],
      "@entropy-tamer/reynard-themes": [
        "../packages/ui/themes/src"
      ],
      "@entropy-tamer/reynard-core": [
        "../packages/core/core/src"
      ],
      "@entropy-tamer/reynard-ui": [
        "../packages/ui/ui/src"
      ],
      "@entropy-tamer/reynard-primitives": [
        "../packages/ui/primitives/src"
      ],
      "@entropy-tamer/reynard-components-core": [
        "../packages/ui/components-core/src"
      ]
    },
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
