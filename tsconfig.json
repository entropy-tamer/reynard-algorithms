{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@entropy-tamer/reynard-i18n": [
        "../i18n/src"
      ],
      "@entropy-tamer/reynard-themes": [
        "../themes/src"
      ],
      "@entropy-tamer/reynard-core": [
        "../core/src"
      ],
      "@entropy-tamer/reynard-primitives": [
        "../primitives/src"
      ]
      },
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
